# Copy to /etc/ghostcorp/backend.env on the backend host.
# Replace every CHANGE_ME value using the hosting provider's private secret manager.
# Never commit the populated file or paste its values into chat.

FEDERATION_ADMIN_TOKEN=CHANGE_ME_GENERATE_LONG_RANDOM_SECRET
OWNER_SESSION_SECRET=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
GITHUB_OAUTH_CLIENT_ID=CHANGE_ME
GITHUB_OAUTH_CLIENT_SECRET=CHANGE_ME
OWNER_GITHUB_LOGIN=CHANGE_ME_EXACT_GITHUB_LOGIN
GHOSTCORP_OWNER_EMAIL=CHANGE_ME_VERIFIED_OWNER_EMAIL
GITHUB_OAUTH_REDIRECT_URI=https://ghostcorpnet.com/auth/github/callback
GHOSTCORP_SITE_ORIGIN=https://ghostcorpnet.com
PUBLIC_FEEDBACK_RATE_SECRET=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_CHARACTERS

# Keep commerce and outbound communications disabled until separately approved.
PAYMENTS_MODE=disabled
CALLING_ENABLED=0
SMS_ENABLED=0
AGENCY_SPEND_CAP_USD=0

# Configure only after provider onboarding and owner approval.
GUMROAD_ACCESS_TOKEN=
GUMROAD_PING_SECRET=
GUMROAD_ALLOWED_PERMALINKS=
GUMROAD_SERVICE_PACKAGE_MAP=
