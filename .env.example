# GhostCorp backend environment template — placeholders only, never real secrets.
# In production mount a persistent volume at /data.
AGENCY_DB_PATH=/data/agency.db
AGENCY_SPEND_CAP_USD=0
AGENCY_PAUSED=0

# Private owner access. Generate distinct random secrets (32+ characters).
FEDERATION_ADMIN_TOKEN=REPLACE_WITH_RANDOM_SECRET
OWNER_SESSION_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
OWNER_GITHUB_LOGIN=
GHOSTCORP_OWNER_EMAIL=
GITHUB_OAUTH_REDIRECT_URI=https://ghostcorpnet.com/auth/github/callback
GHOSTCORP_SITE_ORIGIN=https://ghostcorpnet.com

# Public intake rate limiting. Generate a separate random secret (32+ chars).
PUBLIC_FEEDBACK_RATE_SECRET=REPLACE_WITH_RANDOM_SECRET

# Existing Gumroad store only; no duplicate checkout provider.
# Checkout and Gumroad's digital delivery remain on the existing storefront.
GUMROAD_ACCESS_TOKEN=
GUMROAD_PING_SECRET=
GUMROAD_ALLOWED_PERMALINKS=
# Format: Package=permalink:raw-provider-price:currency;Package2=permalink:raw-price:currency
GUMROAD_SERVICE_PACKAGE_MAP=

# Backend's direct payment mode stays disabled; do not enable a new processor.
PAYMENTS_MODE=disabled
CALLING_ENABLED=0
SMS_ENABLED=0

# Optional private storage roots; configure only on persistent host storage.
GHOSTCORP_WORKSPACE_ROOT=
GHOSTCORP_ARTIFACT_QUARANTINE_ROOT=
